# Copy to .env and adjust if needed:  cp .env.example .env

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_RAW_RATINGS=raw_ratings

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200
KIBANA_URL=http://kibana:5601

# Spark
SPARK_MASTER_URL=spark://spark:7077
SPARK_UI_URL=http://spark:8080

# Ollama
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# Data paths (inside containers)
DATA_RAW_PATH=/data/raw
DATA_PROCESSED_PATH=/data/processed

# Pipeline mode: sample | full
# sample = first SAMPLE_RATINGS rows; full = all ~20M ratings
DATA_MODE=sample
SAMPLE_RATINGS=100000

# App
STREAMLIT_PORT=8501
